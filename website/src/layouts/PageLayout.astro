---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} — ghost.</title>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/" aria-label="Ghost home">
      <img src="/favicon.svg" alt="" />
      <span>ghost<span class="dot">.</span></span>
    </a>
    <nav>
      <a href="/">HOME</a>
      <a href="/docs/">DOCS</a>
      <a href="/linux/">LINUX</a>
      <a href="/about/">ABOUT</a>
    </nav>
    <a class="source-link" href="/docs/">GET STARTED ↗</a>
  </header>

  <main>
    <div class="eyebrow">GHOST / {title.toUpperCase()}</div>
    <slot />
  </main>

  <footer>
    <a class="brand" href="/">
      <img src="/favicon.svg" alt="" />
      <span>ghost<span class="dot">.</span></span>
    </a>
    <span class="copyright">© 2026 blawy</span>
  </footer>
</body>
</html>

<style is:global>
:root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: #0a0a0a; color: #ededed; }
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; min-height: 100vh; }
a { color: inherit; text-decoration: none; }
.topbar { height: 76px; padding: 0 7%; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #242424; }
.brand { display: flex; align-items: center; gap: 10px; font-size: 19px; font-weight: 850; letter-spacing: -1px; }
.brand img { width: 23px; height: 23px; }
.dot { color: #777; }
nav { display: flex; gap: 30px; }
nav a, .source-link, .eyebrow { font-size: 10px; letter-spacing: 1.5px; font-weight: 750; color: #777; transition: color .2s; }
nav a:hover, .source-link:hover { color: #fff; }
main { width: min(900px, 86%); margin: 110px auto 150px; min-height: 55vh; }
.eyebrow { margin-bottom: 30px; }
h1 { font-size: clamp(48px, 8vw, 88px); line-height: .98; letter-spacing: -5px; margin: 0 0 28px; font-weight: 850; }
h2 { margin: 65px 0 18px; font-size: 22px; letter-spacing: -1px; }
h3 { font-size: 15px; margin: 0 0 10px; }
p, li { color: #999; line-height: 1.8; font-size: 14px; max-width: 680px; }
ul { padding-left: 20px; }
.content-link { display: inline-block; color: #ededed; border-bottom: 1px solid #555; padding-bottom: 4px; margin-top: 18px; font-size: 12px; }
.entry { padding: 22px 0; border-top: 1px solid #292929; }
.entry p { margin-bottom: 0; }
code { color: #ddd; background: #171717; padding: 3px 6px; font-size: .9em; }
footer { min-height: 90px; padding: 25px 7%; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #242424; }
.copyright { color: #555; font-size: 10px; letter-spacing: .5px; }
@media(max-width: 600px) {
  .topbar { padding: 0 5%; }
  nav { gap: 12px; }
  nav a { font-size: 9px; }
  .source-link { display: none; }
  main { margin: 75px auto 100px; }
  h1 { letter-spacing: -3px; }
}
@media(prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
